{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Continuity",
  "version": "0.1.0",
  "identifier": "com.continuity.desktop",
  "build": {
  "beforeDevCommand": "pnpm dev",
  "beforeBuildCommand": "pnpm build",
  "devUrl": "http://localhost:5173",
  "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Continuity", "width": 1200, "height": 800 },
      { "label": "quick-overlay", "title": "Continuity", "url": "index.html?window=quick-overlay", "width": 360, "height": 520, "visible": false, "decorations": false, "transparent": true, "shadow": false, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false }
    ]
  }
}
